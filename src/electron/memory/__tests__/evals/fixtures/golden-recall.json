{
  "id": "memory-golden-recall-v1",
  "description": "Golden recall set: saved facts, archive rows, earlier conversations and knowledge-graph entities in one workspace, plus distractors in a second workspace. Queries in English, Turkish and German, with file names; each lists the fixture keys a correct recall returns in its top k.",
  "k": 5,
  "thresholds": {
    "recallAtK": 0.9,
    "mrr": 0.75,
    "crossWorkspaceHits": 0
  },
  "workspaces": [
    {
      "key": "atlas",
      "name": "Atlas"
    },
    {
      "key": "harbor",
      "name": "Harbor"
    }
  ],
  "items": [
    {
      "key": "m-deploy",
      "workspace": "atlas",
      "kind": "rule",
      "content": "Deployments go through the staging cluster first; production deploys need a green canary."
    },
    {
      "key": "m-pnpm",
      "workspace": "atlas",
      "kind": "project_fact",
      "content": "The monorepo uses pnpm workspaces; never run npm install at the repository root."
    },
    {
      "key": "m-tz",
      "kind": "preference",
      "subject": "timezone",
      "content": "Timezone: Europe/Istanbul (UTC+3)."
    },
    {
      "key": "m-tr-meeting",
      "kind": "preference",
      "content": "Haftalık toplantılar salı günleri saat 10:00'da yapılır."
    },
    {
      "key": "m-tr-invoice",
      "workspace": "atlas",
      "kind": "project_fact",
      "content": "Faturalar her ayın ilk iş gününde muhasebe ekibine gönderilir."
    },
    {
      "key": "m-de-review",
      "workspace": "atlas",
      "kind": "rule",
      "content": "Code-Reviews müssen vor dem Merge von zwei Personen freigegeben werden."
    },
    {
      "key": "m-de-vacation",
      "workspace": "atlas",
      "kind": "commitment",
      "content": "Die Urlaubsvertretung für Jürgen übernimmt Grünewald bis Ende Oktober."
    },
    {
      "key": "m-file-invoice",
      "workspace": "atlas",
      "kind": "project_fact",
      "content": "Invoice PDFs are generated by src/billing/invoice-export.ts with the pdfkit renderer."
    },
    {
      "key": "m-file-compose",
      "workspace": "atlas",
      "kind": "project_fact",
      "content": "Local Postgres runs from docker-compose.override.yml on port 5433."
    },
    {
      "key": "m-redis",
      "workspace": "atlas",
      "kind": "decision",
      "content": "Chose Redis Streams over Kafka for the event bus because the team already operates Redis."
    },
    {
      "key": "m-emoji",
      "kind": "correction",
      "content": "Never use emojis in commit messages."
    },
    {
      "key": "m-length",
      "kind": "preference",
      "subject": "response_length",
      "content": "Keep answers short: three sentences unless asked for detail."
    },
    {
      "key": "m-filler-1",
      "workspace": "atlas",
      "kind": "project_fact",
      "content": "The design system tokens live in packages/tokens and are published weekly."
    },
    {
      "key": "m-filler-2",
      "workspace": "atlas",
      "kind": "project_fact",
      "content": "Sentry alerts for the web app go to the #atlas-alerts channel."
    },
    {
      "key": "m-filler-3",
      "workspace": "atlas",
      "kind": "decision",
      "content": "Feature flags are managed in LaunchDarkly, not in environment variables."
    },
    {
      "key": "x-harbor-deploy",
      "workspace": "harbor",
      "kind": "rule",
      "content": "Harbor deployments use blue-green releases on Fly.io; production deploys need a canary."
    },
    {
      "key": "x-harbor-invoice",
      "workspace": "harbor",
      "kind": "project_fact",
      "content": "Harbor invoice PDFs come from scripts/invoice-export.py."
    }
  ],
  "archive": [
    {
      "key": "a-outage",
      "workspace": "atlas",
      "type": "summary",
      "content": "Task completed: \"Fix login outage\"\nOutcome: Root cause was an expired TLS certificate on auth.internal; renewed it and added a cert-expiry alert."
    },
    {
      "key": "a-migration",
      "workspace": "atlas",
      "type": "decision",
      "content": "Decision: approve\nReason: Ship the Postgres 16 migration on Saturday night when traffic is lowest."
    },
    {
      "key": "a-tr-error",
      "workspace": "atlas",
      "type": "error",
      "content": "Tool error for run_command: pnpm build başarısız oldu, modül bulunamadı: @atlas/ui"
    },
    {
      "key": "a-de-report",
      "workspace": "atlas",
      "type": "summary",
      "content": "Task completed: \"Quartalsbericht erstellen\"\nOutcome: Der Quartalsbericht Q3 wurde als quartalsbericht-q3.xlsx im Ordner reports/ gespeichert."
    },
    {
      "key": "a-flaky",
      "workspace": "atlas",
      "type": "error",
      "content": "Verification failed: e2e test checkout.spec.ts is flaky on Safari because the payment iframe loads late."
    },
    {
      "key": "x-harbor-outage",
      "workspace": "harbor",
      "type": "summary",
      "content": "Task completed: \"Harbor login outage\"\nOutcome: The login outage was a misconfigured OAuth redirect."
    }
  ],
  "conversations": [
    {
      "key": "c-logo",
      "workspace": "atlas",
      "task": "logo",
      "type": "user_message",
      "payload": {
        "message": "Can you make the logo in assets/brand/logo-dark.svg a bit larger in the header?"
      }
    },
    {
      "key": "c-tr-csv",
      "workspace": "atlas",
      "task": "csv",
      "type": "user_message",
      "payload": {
        "message": "Müşteri listesini CSV olarak dışa aktarırken Türkçe karakterler bozuluyor, düzeltebilir misin?"
      }
    },
    {
      "key": "c-de-flags",
      "workspace": "atlas",
      "task": "flags",
      "type": "assistant_message",
      "payload": {
        "message": "Ich habe die Datei config/feature-flags.yaml angepasst und das Flag neueKasse aktiviert."
      }
    },
    {
      "key": "c-rate-limit",
      "workspace": "atlas",
      "task": "orders",
      "type": "tool_result",
      "payload": {
        "tool": "run_command",
        "result": "GET /api/v2/orders returned 429 Too Many Requests: the rate limit is 100 requests per minute per token"
      }
    },
    {
      "key": "x-harbor-logo",
      "workspace": "harbor",
      "task": "harbor-logo",
      "type": "user_message",
      "payload": {
        "message": "Replace the Harbor logo-dark.svg in the header with the new one."
      }
    }
  ],
  "entities": [
    {
      "key": "k-juergen",
      "workspace": "atlas",
      "type": "person",
      "name": "Jürgen Weiß",
      "description": "Backend lead; owns the payments service."
    },
    {
      "key": "k-payments",
      "workspace": "atlas",
      "type": "technology",
      "name": "payments-service",
      "description": "Go service that handles Stripe webhooks and refunds."
    },
    {
      "key": "k-ledger",
      "workspace": "atlas",
      "type": "technology",
      "name": "ledger-db",
      "description": "Primary accounting database.",
      "observations": ["Nightly backups run at 02:00 UTC to the eu-west bucket."]
    },
    {
      "key": "x-harbor-person",
      "workspace": "harbor",
      "type": "person",
      "name": "Jürgen Brandt",
      "description": "Harbor operations lead."
    }
  ],
